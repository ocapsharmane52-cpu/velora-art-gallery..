
/* =================================
   VELORA DIGITAL ART GALLERY
   HTML5 AND CSS3 ONLY
================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: #21150f;
    color: #eadbc7;
    font-family: Arial, sans-serif;
}

/* HEADER */

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background-color: #2b1c14;
    border-bottom: 1px solid #60432f;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    letter-spacing: 3px;
    color: #eadbc7;
    text-decoration: none;
}

.logo span,
footer span {
    color: #c69b70;
}

nav a {
    color: #d9c5ae;
    text-decoration: none;
    margin-left: 30px;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover,
nav a.active {
    color: #c69b70;
}

/* HOME HERO */

.hero {
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 70px 8%;
    gap: 50px;
}

.hero-content {
    max-width: 550px;
}

.subtitle {
    color: #c69b70;
    font-size: 12px;
    letter-spacing: 4px;
    margin-bottom: 22px;
}

.hero h1 {
    font-family: Georgia, serif;
    font-size: clamp(42px, 6vw, 75px);
    line-height: 1.15;
    margin-bottom: 25px;
}

.hero h1 span,
.page-banner h1 span {
    color: #c69b70;
    font-style: italic;
}

.description {
    color: #bba995;
    line-height: 1.9;
    margin-bottom: 35px;
}

.btn {
    display: inline-block;
    background-color: #a87952;
    color: #21150f;
    padding: 15px 25px;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 2px;
    transition: 0.3s;
}

.btn:hover {
    background-color: #eadbc7;
    transform: translateY(-4px);
}

.hero-image {
    width: 45%;
}

.hero-image img {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border: 8px solid #39251b;
    outline: 1px solid #a87952;
}

/* WELCOME SECTION */

.welcome {
    text-align: center;
    padding: 90px 10%;
    background-color: #302017;
}

.welcome h2,
.featured h2 {
    font-family: Georgia, serif;
    font-size: 38px;
    margin-bottom: 20px;
}

.welcome p:last-child {
    max-width: 650px;
    margin: auto;
    color: #bba995;
    line-height: 1.8;
}

/* FEATURED ARTWORKS */

.featured {
    padding: 90px 8%;
    text-align: center;
}

.art-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin: 45px 0;
}

.art-card {
    background-color: #39251b;
    padding: 12px;
    text-align: left;
    transition: 0.3s;
}

.art-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px #00000055;
}

.art-card img {
    width: 100%;
    height: 270px;
    object-fit: cover;
}

.art-card h3 {
    margin: 18px 10px 8px;
    font-family: Georgia, serif;
    font-size: 21px;
}

.art-card p {
    color: #b99a7a;
    font-size: 12px;
    margin: 0 10px 15px;
    letter-spacing: 1px;
}

/* ABOUT AND GALLERY PAGE BANNER */

.page-banner {
    text-align: center;
    padding: 100px 20px;
    background-color: #302017;
}

.page-banner h1 {
    font-family: Georgia, serif;
    font-size: clamp(42px, 6vw, 65px);
    margin-bottom: 20px;
}

.page-banner > p:last-child {
    color: #bba995;
    line-height: 1.8;
}

/* ABOUT SECTION */

.about-section {
    display: flex;
    align-items: center;
    gap: 60px;
    padding: 90px 8%;
}

.about-image,
.about-content {
    flex: 1;
}

.about-image img {
    width: 100%;
    max-height: 430px;
    object-fit: cover;
    border: 8px solid #39251b;
}

.about-content h2 {
    font-family: Georgia, serif;
    font-size: 38px;
    margin-bottom: 25px;
}

.about-content p:not(.subtitle) {
    color: #bba995;
    line-height: 1.9;
    margin-bottom: 20px;
}

/* MISSION AND VISION */

.mission {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 70px 8%;
    background-color: #302017;
}

.mission div {
    padding: 30px;
    border-left: 3px solid #a87952;
}

.mission h2 {
    font-family: Georgia, serif;
    margin-bottom: 20px;
    color: #c69b70;
}

.mission p {
    color: #bba995;
    line-height: 1.8;
}

/* GALLERY */

.gallery-section {
    padding: 80px 8%;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.gallery-item {
    background-color: #39251b;
    padding: 12px;
    overflow: hidden;
    transition: 0.3s;
}

.gallery-item:hover {
    transform: translateY(-7px);
    box-shadow: 0 15px 30px #00000055;
}

.gallery-item img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    transition: 0.5s;
}

.gallery-item:hover img {
    transform: scale(1.04);
}

.gallery-info {
    padding: 18px 10px;
}

.gallery-info h3 {
    font-family: Georgia, serif;
    font-size: 21px;
    margin-bottom: 8px;
}

.gallery-info p {
    color: #b99a7a;
    font-size: 12px;
    letter-spacing: 1px;
}

/* FOOTER */

footer {
    background-color: #160e0a;
    text-align: center;
    padding: 45px 20px;
    border-top: 1px solid #60432f;
}

footer h2 {
    font-family: Georgia, serif;
    font-size: 28px;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

footer p {
    color: #a99580;
    font-size: 12px;
    margin: 10px;
}

/* RESPONSIVE DESIGN */

@media (max-width: 850px) {
    .hero {
        gap: 30px;
    }

    .art-container,
    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 20px;
    }

    nav a {
        margin: 0 10px;
    }

    .hero,
    .about-section {
        flex-direction: column;
        text-align: center;
    }

    .hero-image {
        width: 100%;
    }

    .art-container,
    .gallery-grid,
    .mission {
        grid-template-columns: 1fr;
    }

    .welcome h2,
    .featured h2 {
        font-size: 30px;
    }

    .page-banner {
        padding: 70px 20px;
    }
}
